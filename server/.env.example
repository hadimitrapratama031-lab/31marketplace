# =====================================================
# SERVER
# =====================================================
NODE_ENV=development
PORT=4000

# Public URLs (NO localhost in production, use real Railway/custom domain)
CLIENT_URL=http://localhost:5500
ADMIN_URL=http://localhost:5500
SERVER_PUBLIC_URL=http://localhost:4000

# Comma separated list of extra allowed CORS origins (optional)
EXTRA_CORS_ORIGINS=

# Lokasi file frontend (index.html, /admin, /assets). Biarkan KOSONG untuk
# deteksi otomatis. Isi hanya kalau struktur folder tidak standar, misal:
#   FRONTEND_DIR=../          (frontend di root repo — struktur saat ini)
#   FRONTEND_DIR=./public     (frontend dipindah ke dalam /server)
FRONTEND_DIR=

# =====================================================
# DATABASE (source of truth)
# =====================================================
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/marketplace?retryWrites=true&w=majority

# =====================================================
# AUTH / SECURITY
# =====================================================
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_this_to_a_long_random_string
ENCRYPTION_SECRET=change_this_to_a_32_char_random_string

# Bootstrap admin (used once by `npm run seed:admin`, then change password from Admin Web)
ADMIN_BOOTSTRAP_EMAIL=admin@yourstore.com
ADMIN_BOOTSTRAP_PASSWORD=change_this_password
ADMIN_BOOTSTRAP_NAME=Super Admin

# =====================================================
# CLOUDFLARE R2 (file/image storage)
# =====================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=marketplace-assets
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# =====================================================
# KLIKQRIS (payment gateway)
# Docs: https://klikqris.com/dokumentasi-api
# =====================================================
KLIKQRIS_MODE=production
KLIKQRIS_BASE_URL=https://klikqris.com/api
KLIKQRIS_API_KEY=
KLIKQRIS_MERCHANT_ID=
KLIKQRIS_WEBHOOK_URL=https://your-app.up.railway.app/api/payments/klikqris/webhook

# =====================================================
# FONNTE (WhatsApp notifications)
# =====================================================
FONNTE_TOKEN=

# =====================================================
# RESEND (email notifications)
# =====================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourstore.com
RESEND_FROM_NAME=Your Store
# Alamat balasan yang benar-benar dipantau admin (opsional tapi disarankan).
# Kosongkan kalau tidak ada — header Reply-To palsu lebih buruk daripada tidak
# ada sama sekali. Bisa juga diisi dari Admin Web > Integrasi > Resend.
RESEND_REPLY_TO=
# Signing secret dari Resend > Webhooks > (endpoint ini) > Signing Secret.
# Dipakai untuk memverifikasi event delivered/bounced/complained (lihat
# server/controllers/webhook.controller.js). Format: whsec_xxxxxxxx.
# Tanpa ini, endpoint webhook menerima request tapi mengabaikannya (aman,
# tidak pernah memproses payload yang tidak bisa diverifikasi).
RESEND_WEBHOOK_SECRET=
# =====================================================
# DISCORD (notifikasi PAYMENT_SUCCESS ke channel toko)
# =====================================================
# Dua mode, pilih salah satu. Bot dipakai lebih dulu kalau keduanya diisi.
#
# Mode 1 — Bot (disarankan): bot harus punya izin View Channel + Send Messages
# + Embed Links di channel tujuan.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
#
# Mode 2 — Webhook channel (paling cepat dipasang, tanpa bot).
# URL ini memuat token di dalamnya: perlakukan seperti password.
DISCORD_WEBHOOK_URL=

# Jejak DEBUG notifikasi (template mana yang dipilih runtime). Isi "1" hanya
# saat verifikasi setelah deploy, lalu kosongkan lagi.
NOTIF_DEBUG=

# =====================================================
# ASSET PROXY (gambar email/Discord diambil lewat domain toko sendiri)
# =====================================================
# Wajib untuk gambar tampil di Gmail: domain gratis "*.r2.dev" sering
# diblokir bot-protection pihak ketiga untuk proxy gambar Gmail/Discord, walau
# linknya valid dan tampil normal di browser biasa. Server toko sendiri yang
# mengambil gambar dari R2 lalu meneruskannya lewat CLIENT_URL/SERVER_PUBLIC_URL
# — Gmail/Discord tidak pernah menyentuh domain r2.dev sama sekali.
# CLIENT_URL sudah otomatis dipakai sebagai domain proxy; env ini hanya perlu
# diisi kalau ada domain penyimpanan gambar LAIN (custom domain R2, dst.)
# yang juga perlu diizinkan lewat proxy. Pisahkan dengan koma.
ASSET_PROXY_ALLOWED_HOSTS=
